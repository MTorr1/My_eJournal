<hr>
<h3>Daily Tracking</h3>
<%= form.fields_for :responses do |response_form| %> 
  <% column = response_form.object.question.storage_column %>

  <div class="field-group">
    <strong><%= response_form.object.question.content %></strong>
    <%= response_form.hidden_field :id %>
    <%= response_form.hidden_field :question_id %>

    <% if response_form.object.question.question_options.any? %>
    <%= response_form.collection_select column,
        response_form.object.question.question_options,
        :value, :label, {prompt: "Select option here"} %>
    <% elsif response_form.object.question.response_type == "date" %>
    <%= response_form.date_field :date_value, class: "date-picker" %>
#  the above statment is where I am currently working to add my date picker
    <% else %>
        <%= response_form.text_field :text_value, placeholder: "Enter here..." %>
        <% end %>
    </div>
<% end %> 
<%= form.submit "Submit" %>
<% end %>
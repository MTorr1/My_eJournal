<h1><%= @entry.title%></h1>
<h2><%= @entry.created_at.strftime("%Y-%m-%d")%></h2>

<div>
    <p><strong>Body:</strong></p>
    <p><%=  @entry.body %></p>
</div>


<% @entry.responses.each do |response| %>
    <p>
        <strong><%= response.question.content %></strong>
        <%= response.response_label %>
    </p>
 <% end %>

 
 <%= link_to "Edit Entry", edit_journal_entry_path(@entry) %>

 <%= link_to 'Delete Entry', journal_entry_path(@entry), data: {turbo_method: :delete, turbo_confirm: 'Are you sure?'} %>
 
 <%= link_to "Back", journal_entries_path %>





 





 
<h1>Journal Entries</h1>

<table>
  <thead>
    <tr>
      <th>Title</th>
      <th>Date</th>
    </tr>
  </thead>
  <tbody>
    <% @entries.each do |entry| %>
      <tr>
        <td><%= link_to entry.title, journal_entry_path(entry) %></td>
        <td><%= entry.created_at.strftime("%Y-%m-%d") %></td>
        <td><%= link_to 'Delete', journal_entry_path(entry), data: {turbo_method: :delete, turbo_confirm: 'Are you sure?'} %></td>
      </tr>
    <% end %>
  </tbody>
</table>



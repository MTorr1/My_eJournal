<h1>New Entry</h1>

<%= form_with model: @entry do |form| %>
<% if @entry.errors.any? %>
    <div class="errors">
        <h2><%= pluralize(@entry.errors.count, "errors") %> prevented saving:</h2>
        <ul> #what is this???
            <% entry.errors.full_messages.each do |msg|%> 
                <li><%= msg %></li>
            <% end %>
        </ul>
    </div>
<% end %>

<div>
    <%= form.label :title %><br>
    <%= form.text_field :title %>
</div>

<div>
    <%= form.label :body %><br>
    <%= form.text_area :body %>
</div>

